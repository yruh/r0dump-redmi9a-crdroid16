@@ -499,7 +499,10 @@ class Policy:
 
     # load policy
     def __InitPolicy(self, PolicyPath):
-        cPolicyPath = create_string_buffer(PolicyPath.encode("ascii"))
+        # Policy files can live below a non-ASCII workspace path.  Pass the
+        # native filesystem representation to libsepol instead of assuming
+        # that every path is ASCII.
+        cPolicyPath = create_string_buffer(os.fsencode(PolicyPath))
         self.__policydbP = self.__libsepolwrap.load_policy(cPolicyPath)
         if (self.__policydbP is None):
             sys.exit("Failed to load policy")
