+extern "C" __attribute__((visibility("default"))) bool r0dumpGetDexHeaderSnapshot(
+    const void* begin,
+    const void* data_begin,
+    size_t data_size,
+    void* out,
+    size_t out_capacity,
+    size_t* out_size) {
+  if (out_size != nullptr) {
+    *out_size = 0u;
+  }
+  if (out == nullptr || out_capacity == 0u) {
+    return false;
+  }
+  std::lock_guard<std::mutex> lock(gR0DumpDexHeaderSnapshotsMutex);
+  const uint8_t* begin_key = reinterpret_cast<const uint8_t*>(begin);
+  auto it = gR0DumpDexHeaderSnapshots.find(begin_key);
+  if (it == gR0DumpDexHeaderSnapshots.end()) {
+    const uint8_t* data_begin_key = reinterpret_cast<const uint8_t*>(data_begin);
+    for (auto candidate = gR0DumpDexHeaderSnapshots.begin();
+         candidate != gR0DumpDexHeaderSnapshots.end();
+         ++candidate) {
+      if (candidate->second.data_begin == data_begin_key &&
+          candidate->second.data_size == data_size) {
+        it = candidate;
+        break;
+      }
+    }
+  }
+  if (it == gR0DumpDexHeaderSnapshots.end() || it->second.header.empty() ||
+      it->second.header.size() > out_capacity) {
+    return false;
+  }
+  memcpy(out, it->second.header.data(), it->second.header.size());
+  if (out_size != nullptr) {
+    *out_size = it->second.header.size();
+  }
+  return true;
