+  ScopedUtfChars process_name(env, java_process_name);
+  ScopedUtfChars run_id(env, java_run_id);
+  if (env->ExceptionCheck()) return;
+  configureR0DumpRuntime(output_root.c_str() != nullptr ? output_root.c_str() : "",
+                         package_name.c_str() != nullptr ? package_name.c_str() : "",
+                         process_name.c_str() != nullptr ? process_name.c_str() : "",
+                         run_id.c_str() != nullptr ? run_id.c_str() : "legacy",
