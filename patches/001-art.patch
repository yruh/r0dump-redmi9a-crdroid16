+static jobjectArray DexFile_getRegisteredClassLoaders(JNIEnv* env, jclass) {
+  ScopedObjectAccess soa(env);
+  Thread* const self = soa.Self();
+  ClassLinker* const class_linker = Runtime::Current()->GetClassLinker();
+  VariableSizedHandleScope class_loaders(self);
+  class_linker->GetClassLoaders(self, &class_loaders);
+  // ActivityThread only consumes a small bounded prefix.  Do not materialize
+  // an unbounded loader registry into a Java array on processes with many
+  // dynamically-created loaders.
+  const uint32_t loader_count = class_loaders.Size() > 64u ? 64u
+      : static_cast<uint32_t>(class_loaders.Size());
+
+  StackHandleScope<1u> hs(self);
+  Handle<mirror::ObjectArray<mirror::ClassLoader>> result = hs.NewHandle(
+      mirror::ObjectArray<mirror::ClassLoader>::Alloc(
+          self,
+          GetClassRoot<mirror::ObjectArray<mirror::ClassLoader>>(class_linker),
+          loader_count));
+  if (result == nullptr) {
+    DCHECK(self->IsExceptionPending());
+    return nullptr;
+  }
+  for (uint32_t i = 0; i < loader_count; ++i) {
+    result->Set(i, class_loaders.GetHandle<mirror::ClassLoader>(i).Get());
+  }
+  return soa.AddLocalReference<jobjectArray>(result.Get());
+}
+
+class R0DumpLoadedClassNameVisitor final : public ClassVisitor {
+ public:
+  R0DumpLoadedClassNameVisitor(Handle<mirror::ClassLoader> class_loader,
+                               std::set<std::string>* class_names)
+      : class_loader_(class_loader), class_names_(class_names) {}
+
+  bool operator()(ObjPtr<mirror::Class> klass) override
+      REQUIRES_SHARED(Locks::mutator_lock_) {
+    if (class_names_->size() >= 20000u) {
+      return false;
+    }
+    if (klass == nullptr || klass->GetClassLoader() != class_loader_.Get()) {
+      return true;
+    }
+    if (klass->IsArrayClass() || klass->IsPrimitive()) {
+      return true;
+    }
+    std::string temp;
+    const char* descriptor = klass->GetDescriptor(&temp);
+    if (descriptor != nullptr && descriptor[0] == 'L') {
+      class_names_->insert(DescriptorToDot(descriptor));
+    }
+    return true;
+  }
+
+ private:
+  Handle<mirror::ClassLoader> class_loader_;
+  std::set<std::string>* const class_names_;
+};
+
+static jobjectArray DexFile_getLoadedClassNameList(JNIEnv* env,
+                                                   jclass,
+                                                   jobject class_loader) {
+  if (class_loader == nullptr) {
+    return nullptr;
+  }
+  ScopedObjectAccess soa(env);
+  StackHandleScope<1u> hs(soa.Self());
+  Handle<mirror::ClassLoader> loader =
+      hs.NewHandle(soa.Decode<mirror::ClassLoader>(class_loader));
+  if (loader == nullptr) {
+    return nullptr;
+  }
+  std::set<std::string> class_names;
+  R0DumpLoadedClassNameVisitor visitor(loader, &class_names);
+  Runtime::Current()->GetClassLinker()->VisitClasses(&visitor);
+  return soa.AddLocalReference<jobjectArray>(CreateStringArray(soa.Self(), class_names));
+}
