+struct R0DumpDexHeaderSnapshot {
+  const uint8_t* begin = nullptr;
+  const uint8_t* data_begin = nullptr;
+  size_t data_size = 0u;
+  std::vector<uint8_t> header;
+};
+
+std::mutex gR0DumpDexHeaderSnapshotsMutex;
+std::map<const uint8_t*, R0DumpDexHeaderSnapshot> gR0DumpDexHeaderSnapshots;
+
+void R0DumpRememberDexHeaderSnapshot(const uint8_t* begin,
+                                     const uint8_t* data_begin,
+                                     size_t data_size,
+                                     size_t available_size) {
+  if (begin == nullptr || available_size < sizeof(DexFile::Header)) {
+    return;
+  }
+  if (!StandardDexFile::IsMagicValid(begin)) {
+    return;
+  }
+  const DexFile::Header* header = reinterpret_cast<const DexFile::Header*>(begin);
+  size_t header_size = header->header_size_;
+  if (header_size < sizeof(DexFile::Header) || header_size > sizeof(DexFile::HeaderV41) ||
+      header_size > available_size) {
+    header_size = sizeof(DexFile::Header);
+  }
+  size_t prefix_size = header_size;
+  if (data_begin != nullptr && data_begin > begin) {
+    const size_t data_offset = static_cast<size_t>(data_begin - begin);
+    if (data_offset <= available_size && data_offset <= kR0DumpMaxDexHeaderPrefixSnapshot) {
+      prefix_size = std::max(prefix_size, data_offset);
+    }
+  }
+  R0DumpDexHeaderSnapshot snapshot;
+  snapshot.begin = begin;
+  snapshot.data_begin = data_begin;
+  snapshot.data_size = data_size;
+  snapshot.header.assign(begin, begin + prefix_size);
+  std::lock_guard<std::mutex> lock(gR0DumpDexHeaderSnapshotsMutex);
+  gR0DumpDexHeaderSnapshots[begin] = std::move(snapshot);
+}
