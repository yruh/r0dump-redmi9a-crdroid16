diff --git a/extract-files.sh b/extract-files.sh
index 34f4f6d3a9ed295831b5a6bf0e8e25d567b73ac1..c797be15eb916b387fff6c320329ec50e0aa1ccd 100644
--- a/extract-files.sh
+++ b/extract-files.sh
@@ -59,8 +59,18 @@ function blob_fixup() {
             grep -q "libprotobuf-cpp-lite-3.9.1.so" "${2}" && \
             "${PATCHELF}" --replace-needed "libprotobuf-cpp-lite-3.9.1.so" "libprotobuf-cpp-full-3.9.1.so" "${2}"
             ;;
-        vendor/bin/hw/android.hardware.thermal@2.0-service.mtk)
-            "${PATCHELF}" --replace-needed "libhidlbase.so" "libhidlbase-v32.so" "${2}"
+        vendor/lib*/libnvram.so)
+            grep -q "libshim_base.so" "${2}" || "${PATCHELF}" --add-needed "libshim_base.so" "${2}"
+            ;;
+        vendor/lib*/libsysenv.so)
+            grep -q "libshim_base.so" "${2}" || "${PATCHELF}" --add-needed "libshim_base.so" "${2}"
+            ;;
+        vendor/bin/hw/android.hardware.thermal@2.0-service.mtk | \
+        vendor/lib*/hw/android.hardware.thermal@2.0-impl.so)
+            grep -q "libhidlbase.so" "${2}" && \
+                "${PATCHELF}" --replace-needed "libhidlbase.so" "libhidlbase-v32.so" "${2}"
+            grep -q "libutils.so" "${2}" && \
+                "${PATCHELF}" --replace-needed "libutils.so" "libutils-v32.so" "${2}"
             ;;
         vendor/bin/mnld | vendor/lib*/libaalservice.so | vendor/lib*/libcam.utils.sensorprovider.so)
             grep -q "libshim_sensors.so" "$2" || "$PATCHELF" --add-needed "libshim_sensors.so" "$2"
