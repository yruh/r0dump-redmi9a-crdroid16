-    init.angelicain.volte.rc \
-    init.cattail.volte.rc \
-    init.cattail.volte.rc
+    init.mt6765.volte.rc
 
 # Recovery
 PRODUCT_PACKAGES += \
@@ -147,7 +176,6 @@ PRODUCT_PACKAGES += \
