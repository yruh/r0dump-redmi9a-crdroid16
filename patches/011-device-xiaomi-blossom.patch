diff --git a/device.mk b/device.mk
index 18b48c33ebadb94873d500d862691fb974450575..b4f58b3fef1d2646667830dd6c0ef29afd0892f3 100644
--- a/device.mk
+++ b/device.mk
@@ -6,9 +6,28 @@
 
 DEVICE_PATH := device/xiaomi/blossom
 
+# APEX
+# The prebuilt 4.19 kernel does not support EROFS.
+PRODUCT_DEFAULT_APEX_PAYLOAD_TYPE := ext4
+
 # Enable userspace reboot
 $(call inherit-product, $(SRC_TARGET_DIR)/product/userspace_reboot.mk)
 
+# Keep legacy telephony blobs compatible with the Android 16 boot classpath.
+$(call inherit-product, hardware/lineage/compat/frameworks/compat.mk)
+$(call inherit-product, hardware/mediatek/frameworks/mediatek-frameworks.mk)
+
+# The proprietary IMS service directly references these framework classes and
+# cannot load them through the experimental shared-library declarations alone.
+# mediatek-common is already registered by mediatek-frameworks.mk above.
+PRODUCT_BOOT_JARS += \
+    mediatek-framework \
+    mediatek-ims-base \
+    mediatek-ims-common \
+    mediatek-telecom-common \
+    mediatek-telephony-base \
+    mediatek-telephony-common
+
 # Dynamic Partitions
 PRODUCT_USE_DYNAMIC_PARTITIONS := true
 PRODUCT_BUILD_SUPER_PARTITION := false
@@ -32,6 +51,11 @@ WITH_DEXPREOPT_DEBUG_INFO := false
 DONT_DEXPREOPT_PREBUILTS := true
 PRODUCT_ENFORCE_VINTF_MANIFEST := false
 
+# Android 16 trunk drops FCM 5 from its default matrix set, but this device
+# still declares target-level 5.
+PRODUCT_PACKAGES += \
+    framework_compatibility_matrix.5.xml
+
 # Disable kernel requirement enforcement for VINTF compatibility
 PRODUCT_OTA_ENFORCE_VINTF_KERNEL_REQUIREMENTS := false
 
@@ -82,6 +106,16 @@ PRODUCT_DEFAULT_PROPERTY_OVERRIDES := \
     persist.adb.nonblocking_ffs=0 \
     ro.adb.nonblocking_ffs=0
 
+# Use the device-specific USB gadget init script instead of the generic
+# MediaTek prebuilt, which otherwise has the same install name.
+$(call soong_config_set_bool,mediatek_gadget,use_custom_usb_gadget_rc,true)
+$(call soong_config_set_bool,fingerprint_hidl,use_vendor_fingerprint_service,true)
+
+# System-side R0DUMP controller and its privileged permission whitelist.
+PRODUCT_PACKAGES += \
+    R0DUMPManager \
+    privapp_permissions_com_android_r0dumpmanager
+
 # Rootdir
 PRODUCT_PACKAGES += \
     fstab.mt6765 \
@@ -97,12 +131,7 @@ PRODUCT_PACKAGES += \
     init.project.rc \
