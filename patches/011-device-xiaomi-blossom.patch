diff --git a/rootdir/etc/init.mt6762.rc b/rootdir/etc/init.mt6762.rc
index e932c3f7754ad99dc9128733f484257b71a4ccdd..d2c4936f8ef6593d39b9a744d8b6baf6e6f374a3 100644
--- a/rootdir/etc/init.mt6762.rc
+++ b/rootdir/etc/init.mt6762.rc
@@ -715,6 +715,22 @@ service vendor.samsung_nfc_hal_service /vendor/bin/hw/android.hardware.nfc@1.2-s
 on property:sys.boot_completed=1
     # initialize powerHAL when boot is completed
     setprop vendor.powerhal.init 1
+    stop blossom-bootlog
+
+# Opt-in boot log for diagnosing framework startup on userdebug builds.
+on property:persist.r0dump.bootlog=1
+    rm /cache/blossom-boot.log
+    start blossom-bootlog
+
+on property:persist.r0dump.bootlog=0
+    stop blossom-bootlog
+
+service blossom-bootlog /system/bin/logcat -b all -v threadtime -f /cache/blossom-boot.log -r 32768 -n 1 *:V
+    disabled
+    class core
+    user root
+    group root log readproc
+    seclabel u:r:su:s0
 
 service vendor.charger /system/bin/charger
     class charger
