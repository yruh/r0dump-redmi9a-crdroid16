+func TestR8ModuleJvmHeapOverride(t *testing.T) {
+	t.Parallel()
+	result := android.GroupFixturePreparers(
+		PrepareForTestWithJavaDefaultModules,
+		android.FixtureModifyEnv(func(env map[string]string) {
+			env["R0DUMP_LARGE_R8_MODULES"] = "large_app,other_large_app"
+			env["R0DUMP_LARGE_R8_HEAP_SIZE"] = "3072M"
+		}),
+	).RunTestWithBp(t, `
+		android_app {
+			name: "large_app",
+			srcs: ["foo.java"],
+			platform_apis: true,
+		}
+
+		android_app {
+			name: "regular_app",
+			srcs: ["foo.java"],
+			platform_apis: true,
+		}
+	`)
+
+	largeAppR8 := result.ModuleForTests(t, "large_app", "android_common").Rule("r8")
+	regularAppR8 := result.ModuleForTests(t, "regular_app", "android_common").Rule("r8")
+	android.AssertStringEquals(t, "large module R8 heap override",
+		"-JXmx3072M", largeAppR8.Args["r8JvmFlags"])
+	android.AssertStringEquals(t, "regular module must use the global R8 heap",
+		"", regularAppR8.Args["r8JvmFlags"])
+}
