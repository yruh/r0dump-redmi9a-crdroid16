+func r8JvmFlags(ctx android.ModuleContext) string {
+	heapSize := ctx.Config().Getenv("R0DUMP_LARGE_R8_HEAP_SIZE")
+	if heapSize == "" {
+		return ""
+	}
+
+	modules := strings.FieldsFunc(ctx.Config().Getenv("R0DUMP_LARGE_R8_MODULES"), func(r rune) bool {
+		return r == ',' || r == ';' || r == ':' || r == ' ' || r == '\t' || r == '\n'
+	})
+	if android.InList(ctx.ModuleName(), modules) {
+		return "-JXmx" + heapSize
+	}
+	return ""
+}
