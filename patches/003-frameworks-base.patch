+    /** Dump the DEX cookies already owned by a loader for an app/activity trigger. */
+    private void r0dumpDumpClassLoaderDexElements(ClassLoader loader, int strategy) {
+        if (loader == null) {
+            return;
+        }
+        try {
+            Object pathList = r0dumpReadField(loader, "pathList");
+            Object rawElements = r0dumpReadField(pathList, "dexElements");
+            if (!(rawElements instanceof Object[])) {
+                return;
+            }
+            for (Object element : (Object[]) rawElements) {
+                if (element == null) {
+                    continue;
+                }
+                Object rawDexFile = r0dumpReadField(element, "dexFile");
+                if (!(rawDexFile instanceof DexFile)) {
+                    continue;
+                }
+                Object cookie = r0dumpInvokeDex("r0dumpGetCookie",
+                        new Class<?>[] {DexFile.class}, rawDexFile);
+                if (cookie != null) {
+                    r0dumpInvokeDex("r0dumpDumpDexCookie",
+                            new Class<?>[] {Object.class, int.class}, cookie, strategy);
+                }
+            }
+        } catch (Throwable failure) {
+            Log.w(R0DUMP_LOG_TAG, "trigger DEX route failed strategy=0x"
+                    + Integer.toHexString(strategy), failure);
+        }
+    }
+
+    private void r0dumpTriggerDexRoute(Context context, ClassLoader loader,
+            String packageName, int strategy) {
+        final R0DumpProcessConfig config = mR0DumpProcessConfig;
+        if (config == null || !config.enabled
+                || (config.strategyMask & strategy) == 0
+                || context == null
+                || !r0dumpPackageMatches(config, context.getApplicationInfo(), currentProcessName())) {
+            return;
+        }
+        r0dumpInvokeDex("r0dumpMarkPhase", new Class<?>[] {String.class},
+                strategy == R0DUMP_STRATEGY_APP_CREATE ? "app_create" : "activity_create");
+        r0dumpDumpClassLoaderDexElements(loader, strategy);
+        Log.i(R0DUMP_LOG_TAG, "trigger DEX route strategy=0x"
+                + Integer.toHexString(strategy) + " package=" + packageName);
+    }
