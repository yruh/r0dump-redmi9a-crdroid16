+    private boolean r0dumpWalkApplicationDex(Application app, R0DumpProcessConfig config,
+            int generation) {
+        final List<ClassLoader> loaders = r0dumpCollectClassLoaders(app, config);
+        final Set<String> manifestComponents = config.manifestComponentSeedEnabled
+                ? r0dumpManifestComponentNames(app) : Collections.emptySet();
+        final R0DumpWalkStats stats = new R0DumpWalkStats();
+        stats.candidates = loaders.size();
+        stats.manifestComponentClasses = manifestComponents.size();
+        final StringBuilder loaderJson = new StringBuilder("[");
+        boolean firstLoader = true;
+        boolean completed = true;
+        try {
+            for (ClassLoader loader : loaders) {
+                if (generation != mR0DumpConfigGeneration.get() || r0dumpWalkExpired(config)) {
+                    completed = false;
+                    break;
+                }
+                final int dexBefore = stats.dexElements;
+                final int cookiesBefore = stats.uniqueCookies;
+                final boolean walked;
+                try {
+                    walked = r0dumpWalkClassLoader(
+                            loader, config, generation, manifestComponents, stats);
+                } catch (Throwable failure) {
+                    Log.w(R0DUMP_LOG_TAG, "class-loader scan failed: " + loader, failure);
+                    continue;
+                }
+                if (!walked) {
+                    if (generation != mR0DumpConfigGeneration.get()) {
+                        completed = false;
+                        break;
+                    }
+                    continue;
+                }
+                stats.walked++;
+                if (!firstLoader) {
+                    loaderJson.append(',');
+                }
+                firstLoader = false;
+                loaderJson.append("{\"loader\":\"")
+                        .append(r0dumpJsonEscape(loader.toString()))
+                        .append("\",\"identity\":\"")
+                        .append(Integer.toHexString(System.identityHashCode(loader)))
+                        .append("\",\"dex_elements\":")
+                        .append(stats.dexElements - dexBefore)
+                        .append(",\"unique_cookies\":")
+                        .append(stats.uniqueCookies - cookiesBefore)
+                        .append('}');
+                if (stats.walkedClassCount >= R0DUMP_MAX_CLASS_NAMES
+                        || (config.maxMethods > 0
+                                && stats.dumpedMethodCount >= config.maxMethods)) {
+                    break;
+                }
+            }
+            Log.i(R0DUMP_LOG_TAG, "class-walk complete classes=" + stats.walkedClassCount
+                    + " methods=" + stats.dumpedMethodCount
+                    + " forceBackfill=" + stats.forceBackfillCount
+                    + " loaders=" + stats.walked + "/" + stats.candidates
+                    + " dexElements=" + stats.dexElements
+                    + " requestedThreads=" + config.classWalkThreads);
+        } catch (Throwable t) {
+            completed = false;
+            Log.e(R0DUMP_LOG_TAG, "class-walk reflection failed", t);
+        } finally {
+            loaderJson.append(']');
+            r0dumpInvokeDex("r0dumpNoteClassLoaderScan",
+                    new Class<?>[] {int.class, int.class, int.class, int.class, int.class,
+                            int.class, int.class, String.class},
+                    stats.candidates, stats.walked, stats.dexElements, stats.uniqueCookies,
+                    stats.loadedClassTableClasses, stats.manifestComponentClasses,
+                    stats.manifestSeedDumped, loaderJson.toString());
+        }
+        return completed && generation == mR0DumpConfigGeneration.get();
+    }
+
+    private List<ClassLoader> r0dumpCollectClassLoaders(Application app,
+            R0DumpProcessConfig config) {
+        final ArrayList<ClassLoader> loaders = new ArrayList<>();
+        r0dumpAddClassLoader(loaders, app.getClassLoader());
+        if (config.artClassLoaderScanEnabled) {
+            Object registered = r0dumpInvokeDex("r0dumpGetRegisteredClassLoaders",
+                    new Class<?>[0]);
+            if (registered instanceof ClassLoader[]) {
+                for (ClassLoader loader : (ClassLoader[]) registered) {
+                    r0dumpAddClassLoader(loaders, loader);
+                    if (loaders.size() >= R0DUMP_MAX_CLASS_LOADERS) {
+                        break;
+                    }
+                }
+            }
+        }
+        for (int i = 0; i < loaders.size() && loaders.size() < R0DUMP_MAX_CLASS_LOADERS; i++) {
+            try {
+                r0dumpAddClassLoader(loaders, loaders.get(i).getParent());
+            } catch (Throwable ignored) {
+            }
+        }
+        return loaders;
+    }
+
+    private static void r0dumpAddClassLoader(List<ClassLoader> loaders, ClassLoader candidate) {
+        if (!(candidate instanceof BaseDexClassLoader)
+                || loaders.size() >= R0DUMP_MAX_CLASS_LOADERS) {
+            return;
+        }
+        for (ClassLoader loader : loaders) {
+            if (loader == candidate) {
+                return;
+            }
+        }
+        loaders.add(candidate);
+    }
+
+    private Set<String> r0dumpManifestComponentNames(Application app) {
+        final Set<String> names = new ArraySet<>();
+        try {
+            PackageInfo info = app.getPackageManager().getPackageInfo(app.getPackageName(),
+                    PackageManager.GET_ACTIVITIES | PackageManager.GET_RECEIVERS
+                            | PackageManager.GET_SERVICES | PackageManager.GET_PROVIDERS);
+            r0dumpAddComponentNames(names, info.activities, app.getPackageName());
+            r0dumpAddComponentNames(names, info.receivers, app.getPackageName());
+            r0dumpAddComponentNames(names, info.services, app.getPackageName());
+            r0dumpAddComponentNames(names, info.providers, app.getPackageName());
+        } catch (Throwable failure) {
+            Log.w(R0DUMP_LOG_TAG, "manifest component scan failed", failure);
+        }
+        return names;
+    }
+
+    private static void r0dumpAddComponentNames(Set<String> names,
+            ComponentInfo[] components, String packageName) {
+        if (components == null) {
+            return;
+        }
+        for (ComponentInfo component : components) {
+            if (component == null || component.name == null || component.name.isEmpty()) {
+                continue;
+            }
+            String name = component.name;
+            if (name.charAt(0) == '.') {
+                name = packageName + name;
+            } else if (name.indexOf('.') < 0) {
+                name = packageName + '.' + name;
+            }
+            names.add(name);
+        }
+    }
+
+    private boolean r0dumpWalkClassLoader(ClassLoader loader, R0DumpProcessConfig config,
+            int generation, Set<String> manifestComponents, R0DumpWalkStats stats)
+            throws ReflectiveOperationException {
+        Object pathList = r0dumpReadField(loader, "pathList");
+        Object rawElements = r0dumpReadField(pathList, "dexElements");
+        if (!(rawElements instanceof Object[])) {
+            return false;
+        }
+        final Set<String> seenClasses = new ArraySet<>();
+        final boolean loadedOnly = "loaded_only".equals(config.classWalkMode);
+        for (Object element : (Object[]) rawElements) {
+            if (generation != mR0DumpConfigGeneration.get() || r0dumpWalkExpired(config)) {
+                return false;
+            }
+            if (element == null) {
+                continue;
+            }
+            stats.dexElements++;
+            Object rawDexFile = r0dumpReadField(element, "dexFile");
+            if (!(rawDexFile instanceof DexFile)) {
+                continue;
+            }
+            Object cookie = r0dumpInvokeDex("r0dumpGetCookie",
+                    new Class<?>[] {DexFile.class}, rawDexFile);
+            if (cookie == null) {
+                continue;
+            }
+            if (stats.seenCookies.add(cookie)) {
+                stats.uniqueCookies++;
+                r0dumpInvokeDex("r0dumpDumpDexCookie",
+                        new Class<?>[] {Object.class, int.class}, cookie,
+                        R0DUMP_STRATEGY_JAVA_DEXFILE_ROUTE);
+            }
+            if (!loadedOnly) {
+                String[] classNames = (String[]) r0dumpInvokeDex("r0dumpGetClassNameList",
+                        new Class<?>[] {Object.class}, cookie);
+                r0dumpProcessClassNames(classNames, cookie, loader, config, generation,
+                        seenClasses, false, manifestComponents, stats);
+            }
+            if (stats.walkedClassCount >= R0DUMP_MAX_CLASS_NAMES
+                    || (config.maxMethods > 0
+                            && stats.dumpedMethodCount >= config.maxMethods)) {
+                break;
+            }
+        }
+        if ((loadedOnly || config.loadedClassTableScanEnabled)
+                && stats.walkedClassCount < R0DUMP_MAX_CLASS_NAMES) {
+            String[] loadedNames = (String[]) r0dumpInvokeDex("r0dumpGetLoadedClassNameList",
+                    new Class<?>[] {ClassLoader.class}, loader);
+            stats.loadedClassTableClasses += loadedNames != null ? loadedNames.length : 0;
+            r0dumpProcessClassNames(loadedNames, null, loader, config, generation,
+                    seenClasses, false, manifestComponents, stats);
+        }
+        if (config.manifestComponentSeedEnabled
+                && stats.walkedClassCount < R0DUMP_MAX_CLASS_NAMES
+                && (config.maxMethods == 0 || stats.dumpedMethodCount < config.maxMethods)) {
+            r0dumpProcessClassNames(manifestComponents.toArray(new String[0]), null, loader,
+                    config, generation, seenClasses, true, manifestComponents, stats);
+        }
+        return true;
+    }
+
+    private void r0dumpProcessClassNames(String[] classNames, Object cookie, ClassLoader loader,
+            R0DumpProcessConfig config, int generation, Set<String> seenClasses,
+            boolean manifestSeed, Set<String> manifestComponents, R0DumpWalkStats stats) {
+        if (classNames == null) {
+            return;
+        }
+        for (String className : classNames) {
+            if (generation != mR0DumpConfigGeneration.get() || r0dumpWalkExpired(config)
+                    || stats.walkedClassCount >= R0DUMP_MAX_CLASS_NAMES
+                    || (config.maxMethods > 0
+                            && stats.dumpedMethodCount >= config.maxMethods)) {
+                return;
+            }
+            if (className == null || className.isEmpty()
+                    || (!config.classPrefix.isEmpty()
+                            && !className.startsWith(config.classPrefix))
+                    || !seenClasses.add(className)) {
+                continue;
+            }
+            final Class<?> klass;
+            try {
+                klass = Class.forName(className, false, loader);
+                if (klass.getClassLoader() != loader) {
+                    continue;
+                }
+            } catch (Throwable ignored) {
+                continue;
+            }
+            stats.walkedClassCount++;
+            boolean seeded = manifestSeed && manifestComponents.contains(className);
+            try {
+                Method[] methods = klass.getDeclaredMethods();
+                if (config.dumpMethods) {
+                    for (Method method : methods) {
+                        if (config.maxMethods > 0
+                                && stats.dumpedMethodCount >= config.maxMethods) {
+                            break;
+                        }
+                        r0dumpInvokeDex("r0dumpDumpMethod",
+                                new Class<?>[] {Object.class, Object.class, String.class},
+                                method, cookie, className);
+                        stats.dumpedMethodCount++;
+                    }
+                }
+                if (config.dumpConstructors
+                        && (config.maxMethods == 0
+                                || stats.dumpedMethodCount < config.maxMethods)) {
+                    for (java.lang.reflect.Constructor<?> constructor
+                            : klass.getDeclaredConstructors()) {
+                        if (config.maxMethods > 0
+                                && stats.dumpedMethodCount >= config.maxMethods) {
+                            break;
+                        }
+                        r0dumpInvokeDex("r0dumpDumpMethod",
+                                new Class<?>[] {Object.class, Object.class, String.class},
+                                constructor, cookie, className);
+                        stats.dumpedMethodCount++;
+                    }
+                }
+                if (config.forceBackfillEnabled
+                        && (config.forceBackfillMaxMethods == 0
+                                || stats.forceBackfillCount
+                                        < config.forceBackfillMaxMethods)
+                        && (config.forceBackfillClassPrefix.isEmpty()
+                                || className.startsWith(config.forceBackfillClassPrefix))) {
+                    for (Method method : methods) {
+                        if (config.forceBackfillMaxMethods > 0
+                                && stats.forceBackfillCount
+                                        >= config.forceBackfillMaxMethods) {
+                            break;
+                        }
+                        // Native ART invocation has no receiver or arguments.
+                        if (!Modifier.isStatic(method.getModifiers())
+                                || Modifier.isNative(method.getModifiers())
+                                || method.getParameterCount() != 0) {
+                            continue;
+                        }
+                        r0dumpInvokeDex("r0dumpForceBackfillMethod",
+                                new Class<?>[] {Object.class, Object.class, String.class},
+                                method, cookie, className);
+                        stats.forceBackfillCount++;
+                    }
+                }
+            } catch (Throwable failure) {
+                Log.w(R0DUMP_LOG_TAG, "class member scan failed: " + className, failure);
+            }
+            if (seeded) {
+                stats.manifestSeedDumped++;
+            }
+        }
+    }
