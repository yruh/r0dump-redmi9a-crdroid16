+    private static boolean r0dumpPackageMatches(R0DumpProcessConfig config,
+            ApplicationInfo appInfo, String processName) {
+        if (config == null || appInfo == null || processName == null) {
+            return false;
+        }
+        final boolean global = config.globalRuntimeEnabled || "*".equals(config.targetPackage);
+        if (!global && !appInfo.packageName.equals(config.targetPackage)) {
+            return false;
+        }
+        if (R0DUMP_PROCESS_MODE_EXACT.equals(config.processMode)) {
+            return !config.targetProcess.isEmpty() && processName.equals(config.targetProcess);
+        }
+        if (R0DUMP_PROCESS_MODE_ALL.equals(config.processMode)) {
+            return true;
+        }
+        final String mainProcess = appInfo.processName == null || appInfo.processName.isEmpty()
+                ? appInfo.packageName : appInfo.processName;
+        return processName.equals(mainProcess);
+    }
