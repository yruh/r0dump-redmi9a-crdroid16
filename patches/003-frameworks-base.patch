+    private static Field r0dumpFindField(Class<?> type, String name) throws NoSuchFieldException {
+        Class<?> current = type;
+        while (current != null) {
+            try {
+                return current.getDeclaredField(name);
+            } catch (NoSuchFieldException ignored) {
+                current = current.getSuperclass();
+            }
+        }
+        throw new NoSuchFieldException(name);
+    }
+
+    private static Object r0dumpReadField(Object object, String name) throws ReflectiveOperationException {
+        if (object == null) {
+            return null;
+        }
+        Field field = r0dumpFindField(object.getClass(), name);
+        field.setAccessible(true);
+        return field.get(object);
+    }
+
+    private static Object r0dumpInvokeDex(String name, Class<?>[] parameterTypes,
+            Object... arguments) {
+        try {
+            Method method = DexFile.class.getDeclaredMethod(name, parameterTypes);
+            method.setAccessible(true);
+            return method.invoke(null, arguments);
+        } catch (Throwable failure) {
+            synchronized (R0DUMP_REFLECTION_FAILURES) {
+                if (R0DUMP_REFLECTION_FAILURES.add(name)) {
+                    Log.w(R0DUMP_LOG_TAG, "reflection call failed: " + name, failure);
+                }
+            }
+            return null;
+        }
+    }
