+    private void r0dumpStartClassWalkIfNeeded(Application app) {
+        final R0DumpProcessConfig config = mR0DumpProcessConfig;
+        final int generation = mR0DumpConfigGeneration.get();
+        if (app == null || config == null || !config.enabled
+                || (config.strategyMask & R0DUMP_STRATEGY_CLASS_WALK) == 0
+                || !r0dumpPackageMatches(config, app.getApplicationInfo(), currentProcessName())
+                || !mR0DumpClassWalkStarted.compareAndSet(false, true)) {
+            return;
+        }
+        Thread worker = new Thread(() -> {
+            boolean completed = false;
+            String failureReason = "class_walk_failed";
+            try {
+                if (config.delayMs > 0) {
+                    r0dumpInvokeDex("r0dumpMarkPhase",
+                            new Class<?>[] {String.class}, "waiting_delay");
+                    Thread.sleep(config.delayMs);
+                }
+                if (generation != mR0DumpConfigGeneration.get()) {
+                    return;
+                }
+                final long budgetMs = config.maxSeconds > 0
+                        ? Math.min(R0DUMP_MAX_CLASS_WALK_MS,
+                                Math.max(1000L, config.maxSeconds * 1000L))
+                        : R0DUMP_MAX_CLASS_WALK_MS;
+                config.classWalkDeadlineUptimeMs = SystemClock.uptimeMillis() + budgetMs;
+                r0dumpInvokeDex("r0dumpMarkPhase",
+                        new Class<?>[] {String.class}, "class_walk");
+                completed = r0dumpWalkApplicationDex(app, config, generation);
+                if (!completed && r0dumpWalkExpired(config)) {
+                    failureReason = "class_walk_timeout";
+                }
+            } catch (InterruptedException ignored) {
+                Thread.currentThread().interrupt();
+                failureReason = "class_walk_interrupted";
+            } catch (Throwable t) {
+                Log.e(R0DUMP_LOG_TAG, "class-walk failed", t);
+                failureReason = "class_walk_exception";
+            } finally {
+                if (generation == mR0DumpConfigGeneration.get()
+                        && mR0DumpProcessConfig == config && config.enabled) {
+                    if (completed) {
+                        r0dumpInvokeDex("r0dumpMarkPhase", new Class<?>[] {String.class},
+                                "complete");
+                        r0dumpInvokeDex("r0dumpMarkComplete", new Class<?>[0]);
+                    } else {
+                        // A worker that exits early must close the runtime and
+                        // publish a terminal state; otherwise the manager shows
+                        // an old run as permanently "dumping".
+                        r0dumpStopDex(failureReason);
+                    }
+                }
+            }
+        }, "r0dump-class-walk");
+        worker.setDaemon(true);
+        worker.start();
+    }
+
+    private static boolean r0dumpWalkExpired(R0DumpProcessConfig config) {
+        return config == null || (config.classWalkDeadlineUptimeMs > 0
+                && SystemClock.uptimeMillis() >= config.classWalkDeadlineUptimeMs);
+    }
