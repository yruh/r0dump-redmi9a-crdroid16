+    private static int r0dumpParseInt(String value, int defaultValue, int maxValue) {
+        if (value == null || value.trim().isEmpty()) {
+            return defaultValue;
+        }
+        try {
+            return Math.max(0, Math.min(maxValue, Integer.parseInt(value.trim())));
